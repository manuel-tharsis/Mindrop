<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- El contenedor permite centrar una barra de 56 dp sin estirarla al alto que reserve el lanzador. -->
    <LinearLayout
        tools:ignore="UselessParent"
        android:id="@+id/widget_nuevo_evento"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:background="@drawable/widget_agenda_background"
        android:contentDescription="@string/widget_agenda_description"
        android:importantForAccessibility="yes">
        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@mipmap/ic_launcher"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/widget_evento_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="@string/widget_agenda_hint"
            android:textSize="16sp"
            android:fontFamily="sans-serif"
            android:textColor="#BDC1C6"
            android:maxLines="1"
            android:ellipsize="end"
            android:importantForAccessibility="no" />
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/pack_basic_add"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />
    </LinearLayout>
</FrameLayout>
